# Copy to .env for local dev (.env is gitignored — never commit real secrets or a real
# GCP project id). Loaded from backend/.env regardless of the process's cwd.

ENVIRONMENT=development

# Async SQLAlchemy DSN. Local dev DB is `nexus_dev` on the default local Postgres instance
# (postgresql+asyncpg driver, no password needed locally). The LangGraph checkpointer uses the
# same database (converted to a psycopg DSN automatically). Tests use nexus_test.
DATABASE_URL=postgresql+asyncpg://localhost/nexus_dev

# Background jobs (arq) — local Redis (`docker compose up -d redis`). Local dev only;
# deployed envs use Cloud Tasks.
REDIS_URL=redis://localhost:6379/0

# Vector store — Qdrant (`docker compose up -d qdrant`). ":memory:" = in-process (tests).
QDRANT_URL=http://localhost:6333

# AI — Gemini via Vertex AI only (google-genai SDK, Vertex mode), both locally and deployed.
# No API key: auth is via `gcloud auth application-default login` locally, or a service
# account when deployed. Fill in your own project id here, in .env only.
GCP_PROJECT_ID=
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Changing this after data exists requires recreating the Qdrant collections.
EMBEDDING_DIM=768

# Feature matching (plans/ingestion.md §9) — cosine threshold + candidates per chunk.
FEATURE_MATCH_THRESHOLD=0.80
FEATURE_MATCH_TOP_K=5

# Uploaded document blobs (relative paths resolve against backend/) and the upload cap.
BLOB_DIR=./data/blobs
MAX_UPLOAD_MB=25

# Origins allowed to call this API (the client/ Vite dev server).
CORS_ORIGINS=["http://localhost:3000"]
