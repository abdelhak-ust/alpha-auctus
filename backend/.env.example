# Copy to .env for local dev (.env is gitignored — never commit real secrets).

ENVIRONMENT=development

# Async SQLAlchemy DSN. Local dev DB is `nexus_dev` on the default local
# Postgres instance (postgresql+asyncpg driver, no password needed locally).
DATABASE_URL=postgresql+asyncpg://localhost/nexus_dev

# Background jobs (arq) — local Redis. Local dev only; deployed envs use Cloud Tasks.
REDIS_URL=redis://localhost:6379/0

# AI — Vertex AI only (AnthropicVertex + Vertex embeddings), both locally and deployed.
# No API key: auth is via `gcloud auth application-default login` locally, or a service
# account when deployed. Fill in your actual project id/region (Claude-on-Vertex
# availability is region-limited — confirm your models are enabled in Model Garden there).
GCP_PROJECT_ID=
GCP_REGION=us-east5

# Origins allowed to call this API (the client/ Vite dev server).
CORS_ORIGINS=["http://localhost:3000"]
